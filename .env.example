# Copy to .env for local development (this is the only env file you need locally).
# MarketTime API — server-side only, never exposed to browser
MT_API_KEY=your_markettime_api_key
MT_REP_GROUP_ID=R12345
MT_SALESPERSON_ID=your_salesperson_id

# MarketTime B2B customer signup URL (external)
MT_B2B_SIGNUP_URL=https://b2b.markettime.com/signup/your-rep-group

# Supabase — public keys safe for browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase service role — server-side only (admin operations, sync job)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cron / sync auth — required for /api/sync (Vercel cron + admin trigger)
# Generate with: openssl rand -hex 32
CRON_SECRET=your_random_secret

# Transactional email (Resend) — https://resend.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Toys2000 <orders@yourdomain.com>
ORDER_NOTIFY_EMAIL=jimmy@toys2000.com
# Bulk customer import emails go to assigned rep + ORDER_NOTIFY_EMAIL

# Public site URL for email links (optional; Vercel sets VERCEL_URL automatically)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
